{
  "id": "./",
  "name": "Pokt Pal",
  "short_name": "Pokt Pal",
  "description": "Turn USDC from Samsung Wallet into SOL and POKT, stake, and plug Pocket's AI tools into your agents. Non-custodial: your wallet signs everything.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0b0e1c",
  "theme_color": "#1d2670",
  "categories": ["finance", "utilities"],
  "icons": [
    { "src": "icons/app.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/app-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/app-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Buy POKT", "url": "./?tile=buy", "icons": [{ "src": "icons/app-192.png", "sizes": "192x192" }] },
    { "name": "Swap", "url": "./?tile=swap", "icons": [{ "src": "icons/app-192.png", "sizes": "192x192" }] },
    { "name": "Agent Marketplace", "url": "./?tile=marketplace", "icons": [{ "src": "icons/app-192.png", "sizes": "192x192" }] },
    { "name": "Get started", "url": "./#start", "icons": [{ "src": "icons/app-192.png", "sizes": "192x192" }] }
  ],
  "screenshots": [
    { "src": "screenshots/home-phone.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Pokt Pal home with Nodus and Pip" },
    { "src": "screenshots/home-wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Pokt Pal on a larger screen" }
  ]
